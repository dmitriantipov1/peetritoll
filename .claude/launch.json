{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "peetritoll",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "4322"],
      "port": 4322
    },
    {
      "name": "peetritoll-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "app", "run", "dev"],
      "port": 3000
    },
    {
      "name": "peetritoll-docker",
      "runtimeExecutable": "docker",
      "runtimeArgs": ["compose", "--project-directory", "app", "-f", "app/docker-compose.yml", "up", "--build", "-V"],
      "port": 3000
    }
  ]
}
