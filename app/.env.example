# Скопировать в .env и при необходимости поменять. .env в репозиторий не попадает.

# Пользователь, пароль и база PostgreSQL для docker-compose.yml
POSTGRES_USER=peetri
POSTGRES_PASSWORD=peetri
POSTGRES_DB=peetri

# Подключение приложения к базе. При запуске через docker compose хост — db,
# при запуске приложения на машине (npm run dev) — localhost.
NUXT_DATABASE_URL=postgres://peetri:peetri@localhost:5432/peetri

# Адрес сайта без слэша в конце — для абсолютных ссылок hreflang и canonical
NUXT_PUBLIC_I18N_BASE_URL=http://localhost:3000

# Секрет приложения (Nuxt appSecret): из него шифруется cookie сессии админки.
# Не короче 32 символов, свой на каждой машине. В разработке Nuxt создаст временный сам,
# на боевом сервере обязателен. Сгенерировать: openssl rand -base64 32
NUXT_APP_SECRET=

# Отправка писем. В docker compose письма ловит Mailpit (http://localhost:8025) — здесь ничего не нужно.
# На боевом сервере — настоящий SMTP почтового сервиса; порт 465 — шифрование сразу, 587 — STARTTLS
# NUXT_SMTP_HOST=
# NUXT_SMTP_PORT=587
# NUXT_SMTP_USER=
# NUXT_SMTP_PASS=
# NUXT_SMTP_FROM=Peetri Toll <noreply@peetritoll.ee>

# Telegram: бот и канал для заявок (как завести — app/README.md, «Уведомления»). Пусто — без Telegram
# NUXT_TELEGRAM_BOT_TOKEN=
# NUXT_TELEGRAM_CHAT_ID=
